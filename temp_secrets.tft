# variables.tf
variable "db_password" {
  type        = string
  description = "The administrator password for the RDS database"
  sensitive   = true # Hides the value from terminal outputs
}


# for local development
# secrets.auto.tfvars
db_password = "SuperSecretPassword123!"

# 1. Look up the existing secret container in AWS
data "aws_secretsmanager_secret" "db_secret" {
  name = "production/database/password"
}

# 2. Fetch the actual string value stored inside it
data "aws_secretsmanager_secret_version" "db_password_value" {
  secret_id = data.aws_secretsmanager_secret.db_secret.id
}

# 3. Use it directly in your resource
resource "aws_db_instance" "postgres" {
  # ... other settings
  username = "db_admin"
  password = data.aws_secretsmanager_secret_version.db_password_value.secret_string
}


----------------------------------
# karpenter
data "aws_iam_policy_document" "karp_controller_policy" {
    # 
    statement {
      effect = "Allow"
      actions = [ 
      "ec2:RunInstances",
      "ec2:CreateFleet",
      "ec2:CreateTags",
      "ec2:TerminateInstances",
      "ec2:DescribeLaunchTemplates",
      "ec2:DeleteLaunchTemplate",
      "ec2:DescribeInstances",
      "ec2:DescribeInstanceTypes",
      "ec2:DescribeSpotPriceHistory",
      "ec2:DescribeInstanceTypeOfferings",
      "ec2:DescribeSubnets",
      "ec2:DescribeSecurityGroups",
      "ec2:DescribeImages",
      "ec2:CreateLaunchTemplate",
      "ssm:GetParameter",
      "pricing:GetProducts",
      "eks:DescribeCluster",
      "iam:CreateInstanceProfile",  
      "iam:GetInstanceProfile",
      "iam:AddRoleToInstanceProfile",
      "iam:RemoveRoleFromInstanceProfile",
      "iam:DeleteInstanceProfile",
      "iam:TagInstanceProfile"
       ]
       resources = [ "*" ]
    }
    statement {
      effect = "Allow"
      actions = ["iam:PassRole", "iam:ListInstanceProfiles"]
      resources = [ aws_iam_role.karpenter_node.arn, aws_iam_instance_profile.karpenter_profile.arn ]
    }
}
